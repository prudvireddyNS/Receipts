<?xml version="1.0" encoding="utf-8"?>
<!-- A surface plate for the home-screen widget. The colour here is only ever seen in the widget
     picker's preview: the live widget re-tints every plate at update time with
     ImageView.setColorFilter, which is remotable all the way down to minSdk 26 and, because the
     fill is opaque, resolves to exactly the tint colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_preview_track" />
    <corners android:radius="4dp" />
</shape>
