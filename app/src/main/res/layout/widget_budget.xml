<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget: one hero plate over three stat tiles, and nothing else.

     Every surface is an ImageView holding an opaque rounded shape that is re-tinted at update time
     with ImageView.setColorFilter, which is remotable all the way down to minSdk 26 (unlike
     setBackgroundTintList, API 31+). Hard borders come from stacking a border plate under a 2dp
     inset fill plate so the two colours tint independently. The colours written here are only ever
     seen in the widget picker's preview.

     The hero takes all the leftover height (layout_weight="1") so a resized cell grows the card
     instead of stranding it, while the tile strip keeps its intrinsic height. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The card wraps its content and floats in the cell, rather than stretching to fill it. A
         home-screen slot is often much taller than these two blocks need, and a card stretched to
         match it is all empty paper; leftover space is simply left to the wallpaper. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

    <ImageView
        android:id="@+id/widget_card_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_plate_r20_ink" />

    <ImageView
        android:id="@+id/widget_card_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_plate_r17_paper" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="9dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/widget_hero_border"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r14_ink" />

            <ImageView
                android:id="@+id/widget_hero_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r11_hero" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_kicker"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/space_mono_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.06"
                        android:maxLines="1"
                        android:text="@string/widget_kicker_placeholder"
                        android:textColor="@color/widget_preview_hero_on"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/widget_period"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_mono_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.06"
                        android:maxLines="1"
                        android:text="@string/widget_period_placeholder"
                        android:textColor="@color/widget_preview_hero_on"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_hero_amount"
                    android:layout_marginTop="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/bricolage_grotesque_variable"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_amount_placeholder"
                    android:textColor="@color/widget_preview_hero_on"
                    android:textSize="27sp" />

                <TextView
                    android:id="@+id/widget_hero_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_variable"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_support_placeholder"
                    android:textColor="@color/widget_preview_hero_on"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/widget_rail"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_rail_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r4_track" />
            <ImageView
                android:id="@+id/widget_rail_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r4_track" />
            <ImageView
                android:id="@+id/widget_rail_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r4_track" />
            <ImageView
                android:id="@+id/widget_rail_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r4_track" />
            <ImageView
                android:id="@+id/widget_rail_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r4_track" />
            <ImageView
                android:id="@+id/widget_rail_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r4_track" />
            <ImageView
                android:id="@+id/widget_rail_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r4_track" />
            <ImageView
                android:id="@+id/widget_rail_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r4_track" />
            <ImageView
                android:id="@+id/widget_rail_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r4_track" />
            <ImageView
                android:id="@+id/widget_rail_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r4_track" />
            <ImageView
                android:id="@+id/widget_rail_10"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r4_track" />
            <ImageView
                android:id="@+id/widget_rail_11"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="0dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_plate_r4_track" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_tile1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="7dp">

                <ImageView
                    android:id="@+id/widget_tile1_border"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_plate_r11_ink" />

                <ImageView
                    android:id="@+id/widget_tile1_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_plate_r9_tile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp">

                    <TextView
                        android:id="@+id/widget_tile1_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/space_mono_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.06"
                        android:maxLines="1"
                        android:text="@string/widget_tile_label_placeholder"
                        android:textColor="@color/widget_preview_fade"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/widget_tile1_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/bricolage_grotesque_variable"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_tile_value_placeholder"
                        android:textColor="@color/widget_preview_ink"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_tile2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="7dp">

                <ImageView
                    android:id="@+id/widget_tile2_border"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_plate_r11_ink" />

                <ImageView
                    android:id="@+id/widget_tile2_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_plate_r9_tile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp">

                    <TextView
                        android:id="@+id/widget_tile2_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/space_mono_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.06"
                        android:maxLines="1"
                        android:text="@string/widget_tile_label_placeholder"
                        android:textColor="@color/widget_preview_fade"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/widget_tile2_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/bricolage_grotesque_variable"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_tile_value_placeholder"
                        android:textColor="@color/widget_preview_ink"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_tile3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="0dp">

                <ImageView
                    android:id="@+id/widget_tile3_border"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_plate_r11_ink" />

                <ImageView
                    android:id="@+id/widget_tile3_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="2dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_plate_r9_tile" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp">

                    <TextView
                        android:id="@+id/widget_tile3_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/space_mono_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.06"
                        android:maxLines="1"
                        android:text="@string/widget_tile_label_placeholder"
                        android:textColor="@color/widget_preview_fade"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/widget_tile3_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/bricolage_grotesque_variable"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_tile_value_placeholder"
                        android:textColor="@color/widget_preview_ink"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
