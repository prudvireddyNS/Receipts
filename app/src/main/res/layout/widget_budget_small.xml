<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/spline_sans_mono_variable"
        android:includeFontPadding="false"
        android:letterSpacing="0.05"
        android:maxLines="1"
        android:text="@string/widget_kicker_placeholder"
        android:textColor="@color/receipt_fade"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/archivo_variable"
        android:includeFontPadding="false"
        android:fontVariationSettings="'wdth' 125, 'wght' 900"
        android:maxLines="1"
        android:text="@string/widget_amount_placeholder"
        android:textColor="@color/receipt_ink"
        android:textSize="22sp" />

</LinearLayout>
