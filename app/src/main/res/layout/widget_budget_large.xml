<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_period_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/spline_sans_mono_variable"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="@string/widget_period_placeholder"
            android:textColor="@color/receipt_fade"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_days_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans_variable"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_days_placeholder"
            android:textColor="@color/receipt_fade"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_hero_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/archivo_variable"
        android:includeFontPadding="false"
        android:fontVariationSettings="'wdth' 125, 'wght' 900"
        android:maxLines="1"
        android:text="@string/widget_spent_placeholder"
        android:textColor="@color/receipt_ink"
        android:textSize="22sp" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:indeterminate="false"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_brass" />

    <TextView
        android:id="@+id/widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/instrument_sans_variable"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_summary_placeholder"
        android:textColor="@color/receipt_fade"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_empty_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans_variable"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_empty"
            android:textColor="@color/receipt_fade"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_recent_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_recent_merchant_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/instrument_sans_variable"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_merchant_placeholder"
                android:textColor="@color/receipt_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_recent_amount_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/spline_sans_mono_variable"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_debit_placeholder"
                android:textColor="@color/receipt_ink"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_recent_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_recent_merchant_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/instrument_sans_variable"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_merchant_placeholder"
                android:textColor="@color/receipt_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_recent_amount_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/spline_sans_mono_variable"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_debit_placeholder"
                android:textColor="@color/receipt_ink"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_recent_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_recent_merchant_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/instrument_sans_variable"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_merchant_placeholder"
                android:textColor="@color/receipt_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_recent_amount_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/spline_sans_mono_variable"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_debit_placeholder"
                android:textColor="@color/receipt_ink"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_review_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:ellipsize="end"
        android:fontFamily="@font/instrument_sans_variable"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingTop="8dp"
        android:text="@string/widget_review_placeholder"
        android:textColor="@color/receipt_ultramarine"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
