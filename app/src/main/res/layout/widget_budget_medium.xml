<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/spline_sans_mono_variable"
        android:includeFontPadding="false"
        android:letterSpacing="0.05"
        android:maxLines="1"
        android:text="@string/widget_kicker_placeholder"
        android:textColor="@color/receipt_fade"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/archivo_variable"
        android:includeFontPadding="false"
        android:fontVariationSettings="'wdth' 125, 'wght' 900"
        android:maxLines="1"
        android:text="@string/widget_amount_placeholder"
        android:textColor="@color/receipt_ink"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/widget_support"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/instrument_sans_variable"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_support_placeholder"
        android:textColor="@color/receipt_fade"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/widget_rail"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:indeterminate="false"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_brass" />

    <TextView
        android:id="@+id/widget_review"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_pill_chilli"
        android:ellipsize="end"
        android:fontFamily="@font/spline_sans_mono_variable"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="@string/widget_review_placeholder"
        android:textColor="@color/receipt_chilli_on"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
